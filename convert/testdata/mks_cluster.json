{
  "apiVersion": "paas.k8smgmt.io/v3",
  "kind": "Cluster",
  "metadata": {
    "name": "demo-cluster",
    "project": "system-catalog",
    "workspace": "data-test"
  },
  "spec": {
    "billing": {
      "variables": {
        "ContractTerm": "0"
      }
    },
    "blueprint": {
      "name": "minimal",
      "version": "latest"
    },
    "controlPlane": {
      "computeType": "GPU",
      "displayName": "control-plane",
      "osImage": "ubuntu-26",
      "scaling": {
        "count": 1,
        "mode": "manual"
      },
      "shape": {
        "gpu": {
          "count": 1,
          "model": "custom"
        }
      },
      "skuDisplayName": "custom",
      "skuDisplayText": "custom",
      "skuName": "bmaas-test-1",
      "skuType": "BMAAS",
      "sshKey": "mine"
    },
    "kubernetesVersion": "v1.36.4",
    "location": "default-dc",
    "networking": {
      "cni": {
        "name": "Calico",
        "version": "3.32.2"
      },
      "podSubnet": "10.0.0.1/16",
      "serviceSubnet": "10.0.0.1/12",
      "subnet": "default",
      "vpc": "default"
    },
    "profile": {
      "name": "mks-oneclick-1"
    },
    "sharing": {
      "shareMode": "None"
    }
  },
  "status": {
    "action": "deploy",
    "output": {
      "clusterIdEdgesrv": "demo-cluster"
    },
    "reason": "Cluster is ready",
    "status": "MKS_CLUSTER_STATUS_RUNNING"
  },
  "version": 5
}